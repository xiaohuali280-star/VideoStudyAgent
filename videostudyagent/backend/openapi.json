{
  "openapi": "3.1.0",
  "info": {
    "title": "VideoStudyAgent",
    "description": "Local course study API. Upload and task persistence are available.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/tasks": {
      "post": {
        "tags": [
          "tasks"
        ],
        "summary": "Create Task",
        "operationId": "create_task_api_tasks_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "video": {
                    "type": "string",
                    "format": "binary"
                  },
                  "subtitle": {
                    "type": "string",
                    "format": "binary"
                  },
                  "options": {
                    "type": "string",
                    "description": "JSON StudyOptions"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "tasks"
        ],
        "summary": "List Tasks",
        "operationId": "list_tasks_api_tasks_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  },
                  "title": "Response List Tasks Api Tasks Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{task_id}": {
      "get": {
        "tags": [
          "tasks"
        ],
        "summary": "Task Detail",
        "operationId": "task_detail_api_tasks__task_id__get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{task_id}/retry": {
      "post": {
        "tags": [
          "tasks"
        ],
        "summary": "Retry Task",
        "operationId": "retry_task_api_tasks__task_id__retry_post",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{task_id}/result": {
      "get": {
        "tags": [
          "tasks"
        ],
        "summary": "Study Result",
        "operationId": "study_result_api_tasks__task_id__result_get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudyResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{task_id}/exports/{format}": {
      "get": {
        "tags": [
          "tasks"
        ],
        "summary": "Export Result",
        "operationId": "export_result_api_tasks__task_id__exports__format__get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Task Id"
            }
          },
          {
            "name": "format",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Format"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{task_id}/video": {
      "get": {
        "tags": [
          "tasks"
        ],
        "summary": "Course Video",
        "operationId": "course_video_api_tasks__task_id__video_get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Public Config",
        "operationId": "public_config_api_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtifactSummary": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "task_id": {
            "format": "uuid",
            "title": "Task Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "audio",
              "transcript",
              "notes",
              "quiz"
            ],
            "title": "Kind",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "id",
          "task_id",
          "kind",
          "created_at"
        ],
        "title": "ArtifactSummary",
        "type": "object"
      },
      "ErrorInfo": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Step"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "step",
          "retryable"
        ],
        "title": "ErrorInfo",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "const": "VideoStudyAgent",
            "title": "Service",
            "default": "VideoStudyAgent"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "stage": {
            "type": "integer",
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Stage",
            "default": 7
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "status",
          "service",
          "version",
          "stage"
        ],
        "title": "HealthResponse"
      },
      "NoteChapter": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "content_markdown": {
            "minLength": 1,
            "title": "Content Markdown",
            "type": "string"
          },
          "source_segment_ids": {
            "items": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "minItems": 1,
            "title": "Source Segment Ids",
            "type": "array"
          }
        },
        "required": [
          "id",
          "title",
          "content_markdown",
          "source_segment_ids"
        ],
        "title": "NoteChapter",
        "type": "object"
      },
      "NotesDocument": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "learning_objectives": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "title": "Learning Objectives",
            "type": "array"
          },
          "chapters": {
            "items": {
              "$ref": "#/components/schemas/NoteChapter"
            },
            "minItems": 1,
            "title": "Chapters",
            "type": "array"
          },
          "key_concepts": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "title": "Key Concepts",
            "type": "array"
          },
          "summary": {
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "title",
          "learning_objectives",
          "chapters",
          "key_concepts",
          "summary"
        ],
        "title": "NotesDocument",
        "type": "object"
      },
      "PublicConfig": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "max_video_bytes": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Video Bytes"
          },
          "max_subtitle_bytes": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Subtitle Bytes"
          },
          "max_duration_ms": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Duration Ms"
          },
          "export_formats": {
            "items": {
              "type": "string",
              "enum": [
                "notes.md",
                "quiz.md",
                "quiz.json",
                "transcript.json",
                "transcript.srt"
              ]
            },
            "type": "array",
            "title": "Export Formats"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "max_video_bytes",
          "max_subtitle_bytes",
          "max_duration_ms",
          "export_formats"
        ],
        "title": "PublicConfig"
      },
      "Question": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Id",
            "type": "string"
          },
          "type": {
            "const": "short_answer",
            "default": "short_answer",
            "title": "Type",
            "type": "string"
          },
          "difficulty": {
            "enum": [
              "easy",
              "medium",
              "hard"
            ],
            "title": "Difficulty",
            "type": "string"
          },
          "chapter_id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Chapter Id",
            "type": "string"
          },
          "question": {
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "answer": {
            "minLength": 1,
            "title": "Answer",
            "type": "string"
          },
          "explanation": {
            "minLength": 1,
            "title": "Explanation",
            "type": "string"
          },
          "source_segment_ids": {
            "items": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "minItems": 1,
            "title": "Source Segment Ids",
            "type": "array"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/SourceEvidence"
            },
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          }
        },
        "required": [
          "id",
          "type",
          "difficulty",
          "chapter_id",
          "question",
          "answer",
          "explanation",
          "source_segment_ids",
          "evidence"
        ],
        "title": "Question",
        "type": "object"
      },
      "QuizDocument": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "question_count": {
            "maximum": 20,
            "minimum": 1,
            "title": "Question Count",
            "type": "integer"
          },
          "difficulty": {
            "enum": [
              "easy",
              "medium",
              "hard"
            ],
            "title": "Difficulty",
            "type": "string"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Questions",
            "type": "array"
          }
        },
        "required": [
          "schema_version",
          "question_count",
          "difficulty",
          "questions"
        ],
        "title": "QuizDocument",
        "type": "object"
      },
      "SourceEvidence": {
        "additionalProperties": false,
        "properties": {
          "segment_id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Segment Id",
            "type": "string"
          },
          "quote": {
            "minLength": 1,
            "title": "Quote",
            "type": "string"
          }
        },
        "required": [
          "segment_id",
          "quote"
        ],
        "title": "SourceEvidence",
        "type": "object"
      },
      "StudyOptions": {
        "additionalProperties": false,
        "properties": {
          "question_count": {
            "default": 5,
            "maximum": 20,
            "minimum": 1,
            "title": "Question Count",
            "type": "integer"
          },
          "difficulty": {
            "default": "medium",
            "enum": [
              "easy",
              "medium",
              "hard"
            ],
            "title": "Difficulty",
            "type": "string"
          },
          "question_type": {
            "const": "short_answer",
            "default": "short_answer",
            "title": "Question Type",
            "type": "string"
          },
          "output_language": {
            "default": "zh-CN",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
            "title": "Output Language",
            "type": "string"
          },
          "transcript_language": {
            "anyOf": [
              {
                "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Transcript Language"
          }
        },
        "required": [
          "question_count",
          "difficulty",
          "question_type",
          "output_language",
          "transcript_language"
        ],
        "title": "StudyOptions",
        "type": "object"
      },
      "StudyResult": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "task_id": {
            "format": "uuid",
            "title": "Task Id",
            "type": "string"
          },
          "available_artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactSummary"
            },
            "title": "Available Artifacts",
            "type": "array"
          },
          "transcript": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Transcript"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "notes": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NotesDocument"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "quiz": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuizDocument"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "schema_version",
          "task_id",
          "available_artifacts",
          "transcript",
          "notes",
          "quiz"
        ],
        "title": "StudyResult",
        "type": "object"
      },
      "Task": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "options": {
            "$ref": "#/components/schemas/StudyOptions"
          },
          "status": {
            "default": "queued",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "current_step": {
            "anyOf": [
              {
                "enum": [
                  "load_subtitles",
                  "extract_audio",
                  "transcribe_audio",
                  "generate_notes",
                  "generate_quiz"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Current Step"
          },
          "attempt": {
            "default": 1,
            "exclusiveMinimum": 0,
            "title": "Attempt",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Finished At"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "schema_version",
