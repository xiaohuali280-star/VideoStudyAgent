# 服务端配置；复制为项目根目录 .env，所有密钥保持本地。
VSA_ENVIRONMENT=local
VSA_LLM_API_KEY=
VSA_LLM_BASE_URL=https://api.deepseek.com
VSA_LLM_MODEL=deepseek-flash
VSA_LLM_TIMEOUT=60
VSA_LLM_CONTEXT_TOKENS=32768
VSA_LLM_MAX_OUTPUT_TOKENS=4096
VSA_LLM_MAX_REQUESTS=100
VSA_LLM_TOTAL_TOKENS=500000
VSA_ASR_MODEL=small
VSA_ASR_DEVICE=cpu
VSA_ASR_COMPUTE_TYPE=int8
VSA_ASR_CPU_THREADS=4
VSA_ASR_TIMEOUT=900
# VSA_ASR_MODEL_PATH= 可指向预先准备的本地模型目录，不配置则使用 data/models/<model>
# VSA_FFMPEG_BINARY=ffmpeg
# VSA_FFPROBE_BINARY=ffprobe
VSA_MAX_VIDEO_BYTES=524288000
VSA_MAX_SUBTITLE_BYTES=5242880
VSA_MAX_DURATION_MS=7200000
VSA_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# VSA_DATA_DIR 未设置时使用项目根目录 data/；此阶段健康检查不创建数据文件。
